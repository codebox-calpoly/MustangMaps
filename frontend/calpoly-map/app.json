{
  "expo": {
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-asset",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow MustangMaps to use your location.",
          "locationWhenInUsePermission": "Allow MustangMaps to use your location.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-localization"
    ],
    "name": "MustangMaps",
    "slug": "mustangmaps",
    "privacyPolicyUrl": "https://adorable-stetson-5d3.notion.site/MustangMaps-Privacy-Policy-3267e97d19e58048b6c9fb982c116ded",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mustangmaps.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "NSLocationAlwaysUsageDescription": "MustangMaps uses your location to show your position on the campus map and provide turn-by-turn walking directions, even when the app is in the background.",
        "NSLocationWhenInUseUsageDescription": "MustangMaps uses your location to show where you are on the Cal Poly campus map and guide you to buildings, amenities, and destinations.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "MustangMaps uses your location to show your position on the campus map and continue navigating to your destination when you switch to another app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sbalaji524.calpolymap",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "sbalaji524",
    "extra": {
      "eas": {
        "projectId": "93a06625-8fae-47fb-8845-e85a6442ef75"
      }
    }
  }
}
