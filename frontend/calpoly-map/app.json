{
  "expo": {
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MustangMaps uses your location to show your live position on the Cal Poly campus map and provide walking directions to buildings, dining, and other destinations.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "name": "MustangMaps",
    "slug": "mustangmaps",
    "scheme": "mustangmaps",
    "privacyPolicyUrl": "https://adorable-stetson-5d3.notion.site/MustangMaps-Privacy-Policy-3267e97d19e58048b6c9fb982c116ded",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mustangmaps.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "MustangMaps uses your location to show your live position on the Cal Poly campus map and provide walking directions to buildings, dining, and other destinations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sbalaji524.calpolymap",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "sbalaji524",
    "extra": {
      "eas": {
        "projectId": "93a06625-8fae-47fb-8845-e85a6442ef75"
      }
    }
  }
}
